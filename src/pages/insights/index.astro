---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostList from '../../components/PostList.astro';
import Closing from '../../components/Closing.astro';
import { getPosts } from '../../data/insights';

const posts = await getPosts();
---

<Base
  title="Insights"
  description="Engineering notes from Blueforge on taking AI to production, software handovers and marketing attribution for long sales cycles."
>
  <PageHero
    title="From the workshop"
    lede="Working notes on building systems that last. Checklists and methods you can use with or without us."
  />

  <section class="band on-paper">
    <div class="wrap">
      <PostList posts={posts} />
      <p class="feed">Prefer a reader? <a href="/rss.xml">Subscribe by RSS</a>.</p>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .feed {
    margin-top: 2rem;
    color: var(--slate);
  }
  .feed a:hover {
    color: var(--cobalt);
  }
</style>
