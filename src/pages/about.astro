---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Closing from '../components/Closing.astro';
import { site } from '../data/site';

const standards = [
  { h: 'Engineers lead.', t: 'Every project is run by a senior engineer who writes code on it. The person accountable for your system can read its stack traces.' },
  { h: 'Nothing ships untested.', t: 'Automated tests, a load test and a security review come before launch. The pass criteria are agreed with you in advance.' },
  { h: 'Written down.', t: 'Architecture, decisions and runbooks are documented as we go, so knowledge never lives in one head.' },
  { h: 'Yours from day one.', t: 'Code, infrastructure and accounts sit in your name. Leaving us should be easy, and that keeps us honest.' },
];

// Replace with the real team before launch.
const team = [
  { name: '[Founder name is added before launch]', role: '[Role]', bio: '[Two sentences on the systems this person has built and run.]' },
  { name: '[Lead engineer name is added before launch]', role: '[Role]', bio: '[Two sentences on the systems this person has built and run.]' },
  { name: '[Team member name is added before launch]', role: '[Role]', bio: '[Two sentences on the systems this person has built and run.]' },
];
---

<Base
  title="About"
  description="Blueforge is an engineering-led agency. Senior engineers lead every project, nothing ships untested, and everything we build belongs to the client from day one."
>
  <PageHero
    title="A shop run by the people who build."
    lede="We build for year five: the day someone new has to maintain the thing, under load, without us in the room. Planning for that day changes what gets built in month one."
  />

  <section class="band on-paper">
    <div class="wrap">
      <div class="band-head">
        <h2>Shop standards</h2>
        <p class="lede">Four rules that apply to every project, whatever the size.</p>
      </div>
      <ul class="standards">
        {
          standards.map((s) => (
            <li>
              <h3>{s.h}</h3>
              <p>{s.t}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band on-white">
    <div class="wrap">
      <div class="band-head">
        <h2>The team</h2>
      </div>
      <ul class="team">
        {
          team.map((m) => (
            <li>
              <div class="photo" aria-hidden="true" />
              <h3 class="todo">{m.name}</h3>
              <p class="todo">{m.role}</p>
              <p class="todo">{m.bio}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band on-paper">
    <div class="wrap reach">
      <h2>How to reach us</h2>
      <dl>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>Address</dt>
          <dd>
            {site.legalEntity}, {site.address.street}, {site.address.city}, {site.address.region} {site.address.postal}, USA
          </dd>
        </div>
        <div>
          <dt>Reply time</dt>
          <dd>Within one working day.</dd>
        </div>
      </dl>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .standards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(2rem, 6vw, 6rem);
  }
  .standards li {
    border-top: 6px solid var(--ink);
    padding-block: 1.5rem 3rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .standards p {
    color: var(--slate);
  }
  .reach {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .reach h2 {
    font-size: clamp(1.7rem, 1.1rem + 2vw, 2.6rem);
  }
  .reach dl {
    margin: 0;
    border-top: 6px solid var(--ink);
  }
  .reach dl div {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-block: 1.1rem;
  }
  .reach dt {
    font-weight: 600;
    color: var(--slate);
  }
  .reach dd {
    margin: 0;
    justify-self: start;
    min-width: 0;
    font-weight: 600;
  }
  .reach a:hover {
    color: var(--cobalt);
  }
  @media (max-width: 36rem) {
    .reach dl div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .team li {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    align-content: start;
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--paper);
    clip-path: var(--chamfer);
    margin-bottom: 0.5rem;
  }
  .team h3.todo {
    font-size: var(--t-md);
  }
  @media (max-width: 52rem) {
    .reach {
      grid-template-columns: 1fr;
    }
    .standards,
    .team {
      grid-template-columns: 1fr;
    }
    .photo {
      aspect-ratio: 3 / 2;
    }
  }
</style>
