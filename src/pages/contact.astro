---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, services } from '../data/site';

const next = [
  'Your message goes to a senior engineer, who reads it the same day.',
  'We reply within one working day to set up a 30-minute call.',
  "On the call we ask about the system, the data and the constraints. If it's a fit, the next step is a scoped assay with a fixed price. If it isn't, we'll say so and suggest where to go.",
];
---

<Base
  title="Talk to an engineer"
  description="Tell Blueforge about the system you need built, fixed or hardened. A senior engineer replies within one working day."
>
  <PageHero
    title="Talk to an engineer"
    lede="Describe the system and what's at stake. The person who reads your message is the kind of person who would build it."
  />

  <section class="band on-paper">
    <div class="wrap grid">
      <form
        class="form"
        data-contact
        data-endpoint={site.formEndpoint}
        data-email={site.email}
        action={site.formEndpoint || `mailto:${site.email}`}
        method="post"
        novalidate
      >
        <div class="pair">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
            <p class="error" data-error-for="name" hidden>Add your name so we know who to reply to.</p>
          </div>
          <div class="field">
            <label for="email">Work email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
            <p class="error" data-error-for="email" hidden>Enter an email address like name@company.com.</p>
          </div>
        </div>
        <div class="pair">
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="role">Your role</label>
            <input id="role" name="role" type="text" autocomplete="organization-title" />
          </div>
        </div>
        <fieldset class="field">
          <legend>Which services are involved?</legend>
          <div class="checks">
            {
              services.map((s) => (
                <label class="check">
                  <input type="checkbox" name="need" value={s.id} data-label={s.name} />
                  <span>{s.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field">
          <label for="message">The system and the problem</label>
          <textarea id="message" name="message" rows="6" required></textarea>
          <p class="error" data-error-for="message" hidden>Tell us a little about the system. Two or three sentences is enough to start.</p>
        </div>
        <button class="btn btn-blue" type="submit">Send to an engineer</button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>

      <aside>
        <h2>What happens next</h2>
        <ol class="next">
          {next.map((n) => <li>{n}</li>)}
        </ol>
        <address class="direct">
          <p>Prefer to call or write?</p>
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <p>
            {site.legalEntity}<br />
            {site.address.street}<br />
            {site.address.city}, {site.address.region} {site.address.postal}, USA
          </p>
        </address>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    // Pre-check the service the visitor came from (?need=software).
    const need = new URLSearchParams(location.search).get('need')?.split(',') ?? [];
    for (const box of form.querySelectorAll<HTMLInputElement>('input[name="need"]')) {
      if (need.includes(box.value)) box.checked = true;
    }

    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const showError = (name: string, show: boolean) => {
      const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLInputElement;
      if (el) el.hidden = !show;
      input.setAttribute('aria-invalid', String(show));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const name = get('name');
      const email = get('email');
      const message = get('message');
      const bad = {
        name: !name,
        email: !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email),
        message: !message,
      };
      let first: string | undefined;
      for (const [k, v] of Object.entries(bad)) {
        showError(k, v);
        if (v && !first) first = k;
      }
      if (first) {
        (form.elements.namedItem(first) as HTMLElement).focus();
        return;
      }

      const needs = [...form.querySelectorAll<HTMLInputElement>('input[name="need"]:checked')].map((b) => b.dataset.label);
      const company = get('company');
      const role = get('role');
      const endpoint = form.dataset.endpoint;

      if (endpoint) {
        status.textContent = 'Sending…';
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ name, email, company, role, needs, message }),
          });
          if (!res.ok) throw new Error(String(res.status));
          location.href = '/contact/thanks/';
        } catch {
          status.textContent = `That didn't send. Check your connection and try again, or email ${form.dataset.email}.`;
        }
      } else {
        const lines = [`Name: ${name}`];
        if (company) lines.push(`Company: ${company}`);
        if (role) lines.push(`Role: ${role}`);
        if (needs.length) lines.push(`Services: ${needs.join(', ')}`);
        lines.push('', message);
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Enquiry from ' + name)}&body=${encodeURIComponent(lines.join('\n'))}`;
        status.textContent = `Your email app should have opened with the message ready to send. If it didn't, write to ${form.dataset.email}.`;
      }
    });
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .pair {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .field {
    width: 100%;
    display: grid;
    gap: 0.45rem;
    border: 0;
    margin: 0;
    padding: 0;
    align-content: start;
  }
  label,
  legend {
    font-weight: 600;
    padding: 0;
  }
  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--white);
    border: 0;
    border-bottom: 3px solid var(--ink);
    padding: 0.85rem 1rem;
    border-radius: 0;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 0;
  }
  textarea {
    resize: vertical;
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-bottom-color: #b3261e;
  }
  .error {
    color: #b3261e;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .checks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 500;
    background: var(--white);
    padding: 0.8rem 1rem;
    cursor: pointer;
    border-left: 6px solid var(--rule);
  }
  .check:has(input:checked) {
    border-left-color: var(--cobalt);
  }
  .check input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--cobalt);
  }
  .status:empty {
    display: none;
  }
  .status {
    background: var(--white);
    border-left: 6px solid var(--cobalt);
    padding: 1rem 1.25rem;
    font-weight: 500;
  }

  aside {
    background: var(--blued);
    color: var(--white);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    clip-path: var(--chamfer);
    --cut: 28px;
  }
  aside h2 {
    font-size: var(--t-lg);
  }
  aside :focus-visible {
    outline-color: var(--sky);
  }
  .next {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 1.25rem;
  }
  .next li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.75rem;
    color: var(--steel);
  }
  .next li::before {
    content: counter(step);
    font-stretch: 125%;
    font-weight: 800;
    font-size: var(--t-md);
    line-height: 1.3;
    color: var(--sky);
  }
  .direct {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(185 196 224 / 0.35);
    font-style: normal;
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }
  .direct p:first-child {
    font-weight: 700;
  }
  .direct a:hover {
    color: var(--sky);
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 34rem) {
    .pair,
    .checks {
      grid-template-columns: 1fr;
    }
  }
</style>
