---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Closing from '../../components/Closing.astro';
import { services } from '../../data/site';
---

<Base
  title="Services"
  description="Software development, AI implementation, AI consulting and digital marketing from Blueforge. What each service is for, what you receive and how long it takes."
>
  <PageHero
    title="Four services, one engineering standard."
    lede="Every engagement is tested before it ships and handed over with everything you need to run it without us."
  />

  <section class="band on-paper">
    <div class="wrap">
      <ul class="sheets">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`}>
                <h2>{s.name}</h2>
                <div class="about">
                  <p class="purpose">{s.purpose}</p>
                  <p class="who">{s.forWho}</p>
                </div>
                <dl>
                  <div>
                    <dt>Yours at handover</dt>
                    <dd>{s.handover}</dd>
                  </div>
                  <div>
                    <dt>Typical duration</dt>
                    <dd>{s.duration}</dd>
                  </div>
                </dl>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .sheets {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 6px solid var(--ink);
  }
  .sheets a {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: 1.25rem clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-block: 2.75rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .sheets h2 {
    font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.4rem);
    text-decoration: underline;
    text-decoration-color: var(--cobalt);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }
  .sheets a:hover h2 {
    color: var(--cobalt);
  }
  .about {
    display: grid;
    gap: 0.9rem;
  }
  .purpose {
    font-size: var(--t-md);
    line-height: 1.45;
  }
  .who {
    color: var(--slate);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 1.1rem;
  }
  dt {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--slate);
  }
  dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  @media (max-width: 58rem) {
    .sheets a {
      grid-template-columns: 1fr;
    }
  }
</style>
