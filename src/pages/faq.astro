---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import { faqGroups } from '../data/site';

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const schema = {
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((g) =>
    g.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  ),
};
---

<Base
  title="Questions and answers"
  description="How Blueforge works, how engagements are priced, who owns the code and how we handle security and AI data."
  schema={schema}
>
  <PageHero title="Questions we get asked" lede="Answered the way we'd answer them in the room. If yours is missing, bring it to the call.">
    <nav class="jump" aria-label="Question groups">
      {faqGroups.map((g) => <a href={`#${slug(g.title)}`}>{g.title}</a>)}
    </nav>
  </PageHero>

  <section class="band on-paper">
    <div class="wrap groups">
      {
        faqGroups.map((g) => (
          <div class="group" id={slug(g.title)}>
            <h2>{g.title}</h2>
            <Faq items={g.items} />
          </div>
        ))
      }
    </div>
  </section>

  <Closing />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-weight: 600;
  }
  .jump a:hover {
    color: var(--sky);
  }
  .groups {
    display: grid;
    gap: clamp(3rem, 6vw, 5.5rem);
  }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
    scroll-margin-top: 2rem;
  }
  .group h2 {
    font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.4rem);
  }
  @media (max-width: 58rem) {
    .group {
      grid-template-columns: 1fr;
    }
  }
</style>
