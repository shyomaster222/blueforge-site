---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostList from '../components/PostList.astro';
import Closing from '../components/Closing.astro';
import { site } from '../data/site';
import { getPosts, formatDate, readingTime, topic, type Post } from '../data/insights';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const tag = topic(post);
const more = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 2);
const schema = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(`/insights/${post.id}/`, Astro.site).href,
};
---

<Base title={post.data.title} description={post.data.description} schema={schema} ogType="article">
  <article>
    <header class="on-blue head">
      <div class="wrap inner">
        <Breadcrumbs crumbs={[{ label: 'Insights', href: '/insights/' }, { label: post.data.title }]} />
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="meta">
          <a class="tag" href={tag.href}>{tag.label}</a>
          <span>{site.byline}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>{readingTime(post)}</span>
        </p>
      </div>
    </header>

    <div class="on-white">
      <div class="wrap body">
        <div class="prose">
          <slot />
        </div>
        <aside>
          <h2>Have a system like this?</h2>
          <p>Bring it to a 30-minute call with an engineer. You'll leave knowing whether an assay is worth doing.</p>
          <a class="btn" href="/contact/">{site.cta}</a>
          <a class="quiet" href={tag.href}>More about {tag.label.startsWith('AI') ? tag.label : tag.label.toLowerCase()}</a>
        </aside>
      </div>
    </div>
  </article>

  <section class="band on-paper">
    <div class="wrap">
      <div class="band-head">
        <h2>Keep reading</h2>
      </div>
      <PostList posts={more} />
    </div>
  </section>

  <Closing />
</Base>

<style>
  .head {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5.5rem);
  }
  .inner {
    display: grid;
    gap: 1.75rem;
  }
  h1 {
    font-size: clamp(2rem, 1rem + 3.6vw, 3.9rem);
    max-width: 22ch;
  }
  .meta {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.5rem;
    color: var(--steel);
    font-size: 0.95rem;
  }
  .tag {
    color: var(--sky);
    font-weight: 700;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  /* Markdown content is rendered by Astro, so these rules reach into it. */
  .prose {
    font-size: 1.1875rem;
    line-height: 1.7;
    max-width: 68ch;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4em;
    max-width: none;
  }
  .prose :global(h2) {
    font-stretch: 112%;
    font-weight: 700;
    font-size: var(--t-lg);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 2.4em 0 0.7em;
    padding-top: 1.1em;
    border-top: 3px solid var(--ink);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.2em;
  }
  .prose :global(li::marker) {
    color: var(--cobalt);
    font-weight: 700;
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(a) {
    color: var(--cobalt);
  }

  aside {
    position: sticky;
    top: 2rem;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    background: var(--blued);
    color: var(--white);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    clip-path: var(--chamfer);
    --cut: 26px;
  }
  aside h2 {
    font-size: var(--t-lg);
    font-stretch: 112%;
  }
  aside p {
    color: var(--steel);
  }
  aside .quiet {
    font-size: 0.95rem;
  }
  aside .quiet:hover {
    color: var(--sky);
  }
  aside :focus-visible {
    outline-color: var(--sky);
  }

  @media (max-width: 60rem) {
    .body {
      grid-template-columns: 1fr;
    }
    aside {
      position: static;
    }
  }
</style>
