---
import { formatDate, readingTime, topic, type Post } from '../data/insights';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={`/insights/${post.id}/`}>
          <h3>{post.data.title}</h3>
          <p class="desc">{post.data.description}</p>
          <p class="meta">
            <span class="tag">{topic(post).label}</span>
            <span>{formatDate(post.data.date)}</span>
            <span>{readingTime(post)}</span>
          </p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Same spec-sheet rhythm as the services table. */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 6px solid var(--ink);
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) minmax(0, 2fr);
    gap: 0.75rem clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-block: 1.9rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  h3 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: var(--t-lg);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  a:hover h3 {
    color: var(--cobalt);
  }
  .desc {
    color: var(--slate);
  }
  .meta {
    display: grid;
    gap: 0.25rem;
    font-size: 0.95rem;
    color: var(--slate);
    font-variant-numeric: tabular-nums;
  }
  .tag {
    font-weight: 700;
    color: var(--cobalt);
  }
  @media (max-width: 58rem) {
    a {
      grid-template-columns: 1fr;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
  }
</style>
