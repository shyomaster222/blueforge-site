---
import type { Faq } from '../data/site';

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 6px solid var(--ink);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    font-stretch: 112%;
    font-weight: 700;
    font-size: var(--t-md);
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Plus that becomes a bar, the same marks as the fit list. */
  summary::after {
    content: '';
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.3rem;
    background:
      linear-gradient(var(--cobalt), var(--cobalt)) center / 100% 0.3rem no-repeat,
      linear-gradient(var(--cobalt), var(--cobalt)) center / 0.3rem 100% no-repeat;
  }
  details[open] summary::after {
    background: linear-gradient(var(--cobalt), var(--cobalt)) center / 100% 0.3rem no-repeat;
  }
  details p {
    padding-bottom: 1.5rem;
    color: var(--slate);
  }
</style>
