---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  lede: string;
  crumbs?: Crumb[];
}
const { title, lede, crumbs } = Astro.props;
---

<section class="on-blue page-hero">
  <div class="wrap inner">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6.5rem);
  }
  .inner {
    display: grid;
    gap: 2rem;
  }
  h1 {
    font-size: clamp(2.1rem, 0.9rem + 5vw, 4.75rem);
    max-width: 18ch;
  }
</style>
